# Copy to .env.local for local development. Never commit real values.
# All of these are SERVER-ONLY. Nothing in this site needs a NEXT_PUBLIC_ variable — do not add
# NEXT_PUBLIC_ to any of them (that would ship the value to every visitor's browser).

# Base URL of the management dashboard (no trailing slash). The site calls
# ${DASHBOARD_API_URL}/api/public/v1/... from its server only.
DASHBOARD_API_URL=http://localhost:3000

# Site key created in the dashboard:
#   npm run site-key -- create --business <business-slug> --name "Customer website"
# It is shown once. Scopes: site:read, catalog:read, inquiries:write.
DASHBOARD_SITE_KEY=replace-with-the-site-key-from-the-dashboard

# Shared secret for POST /api/revalidate (header x-revalidate-secret). Use a long random value,
# e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
REVALIDATE_SECRET=replace-with-a-long-random-string

# Public URL of this website (used for canonical metadata, sitemap.xml and robots.txt).
SITE_URL=http://localhost:3200

# Optional: set to 1 to keep search engines out (also automatic when the business is a demo).
SITE_NOINDEX=

# Optional: extra frame origins for a white-label GoHighLevel booking-widget domain
# (space-separated), e.g. https://bookings.youragency.com
CSP_EXTRA_FRAME_SRC=
