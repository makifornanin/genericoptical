# ── Database ───────────────────────────────────────────────────────────────
# Local/demo: `npm run db:start` runs a real PostgreSQL server on port 54329.
# Production: any PostgreSQL 15+ (Neon, Supabase, RDS…). Needs the btree_gist extension
# (enabled automatically by the migrations; available on Neon and Supabase).
DATABASE_URL=postgres://postgres:postgres@localhost:54329/specta

# ── Security ───────────────────────────────────────────────────────────────
# 32+ random characters. Encrypts stored integration credentials (AES-256-GCM).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=replace-with-at-least-32-random-characters

# Public base URL (used in password-reset links and webhook URLs shown in Settings).
APP_URL=http://localhost:3000

# ── Demo mode ──────────────────────────────────────────────────────────────
# true  → demo banner, demo sign-in accounts listed on the login page, owner can reset demo data.
# false → production behaviour. The reset tool is unavailable and the seed refuses to wipe data.
DEMO_MODE=true

# Which business's name and colours the sign-in page shows (its slug). Defaults to the first business.
# SITE_BUSINESS_SLUG=lensmere-optical

# The customer website now runs on GoHighLevel. If set at BUILD time, old public paths (/book,
# /contact, /eyewear, …) redirect there; otherwise they return 404.
# PUBLIC_WEBSITE_URL=https://www.example-optical.com

# Expense attachments (local disk adapter). Use object storage for serverless hosting.
UPLOAD_DIR=.data/uploads

# Shared secret for the scheduled GoHighLevel sync worker (POST /api/integrations/ghl/process with
# "Authorization: Bearer <CRON_SECRET>", every 1–5 minutes; add ?reconcile=1 hourly). The same bearer
# unlocks detailed output from /api/health. Leave unset to disable both.
# CRON_SECRET=replace-with-a-long-random-string

# Number of reverse proxies in front of the app that append to X-Forwarded-For (used for sign-in
# throttling by IP). 1 for a single load balancer / Vercel; 0 if the app is exposed directly.
# TRUST_PROXY_HOPS=1

# Log verbosity for the structured JSON logs: debug | info | warn | error (default info).
# LOG_LEVEL=info

# Email: no provider is integrated yet. Password-reset links are printed in the server log in
# development; in production owners issue temporary passwords from Staff. See docs/INTEGRATIONS.md.

# ── GoHighLevel ────────────────────────────────────────────────────────────
# Marketplace app (OAuth). One app serves every business; each business connects its own GHL
# sub-account from Settings → Integrations → GoHighLevel. Tokens are stored per business, encrypted
# with APP_SECRET, and never sent to the browser. See docs/GHL_SETUP_GUIDE.md.
# Without these, a business can still connect with a Private Integration token (also in Settings).
# GHL_CLIENT_ID=your-marketplace-app-client-id
# GHL_CLIENT_SECRET=your-marketplace-app-client-secret
# Must exactly match a redirect URL registered on the app. Defaults to
# <APP_URL>/api/integrations/ghl/oauth/callback
# GHL_REDIRECT_URI=https://dashboard.example.com/api/integrations/ghl/oauth/callback
# White-label agencies: https://marketplace.leadconnectorhq.com (default https://marketplace.gohighlevel.com)
# GHL_MARKETPLACE_URL=https://marketplace.gohighlevel.com

# Webhook signature keys. Leave unset to use GoHighLevel's published keys (built in). Set only if GHL
# announces a key rotation before this code is updated. PEM on one line, with \n for line breaks.
# GHL_WEBHOOK_ED25519_PUBLIC_KEY=
# GHL_WEBHOOK_RSA_PUBLIC_KEY=
