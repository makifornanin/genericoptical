# ── Database ───────────────────────────────────────────────────────────────
# Local/demo: `npm run db:start` runs a real PostgreSQL server on port 54329.
# Production: any PostgreSQL 15+ (Neon, Supabase, RDS…). Needs the btree_gist extension
# (enabled automatically by the migrations; available on Neon and Supabase).
DATABASE_URL=postgres://postgres:postgres@localhost:54329/specta

# ── Security ───────────────────────────────────────────────────────────────
# 32+ random characters. Encrypts stored integration credentials (AES-256-GCM).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=replace-with-at-least-32-random-characters

# Public base URL (used in password-reset links and webhook URLs shown in Settings).
APP_URL=http://localhost:3000

# ── Demo mode ──────────────────────────────────────────────────────────────
# true  → demo banner, demo sign-in accounts listed on the login page, owner can reset demo data.
# false → production behaviour. The reset tool is unavailable and the seed refuses to wipe data.
DEMO_MODE=true

# Which business the public website shows (its slug). Defaults to the first business created.
# SITE_BUSINESS_SLUG=lensmere-optical

# Expense attachments (local disk adapter). Use object storage for serverless hosting.
UPLOAD_DIR=.data/uploads

# Shared secret for the scheduled GoHighLevel sync endpoint (POST /api/integrations/ghl/process
# with "Authorization: Bearer <CRON_SECRET>"). Leave unset to disable the endpoint.
# CRON_SECRET=replace-with-a-long-random-string

# Email: no provider is integrated yet. Password-reset links are printed in the server log in
# development; in production owners issue temporary passwords from Staff. See docs/INTEGRATIONS.md.

# ── GoHighLevel ────────────────────────────────────────────────────────────
# Not configured via env. Each business stores its own Private Integration token and
# location ID in Settings → Integrations (encrypted with APP_SECRET).
