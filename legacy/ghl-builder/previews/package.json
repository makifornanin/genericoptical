{
  "name": "optical-customer-website-preview",
  "private": true,
  "description": "Local preview, screenshots and tests for the GHL-ready optical customer website. Tooling only — nothing here is pasted into GoHighLevel.",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "build:alt": "node build.mjs --config=examples/alt-config.js --out=previews/site-alt",
    "serve": "node serve.mjs",
    "test": "node build.mjs && playwright test",
    "screenshots": "node build.mjs && node tools/screenshots.mjs",
    "compare": "node tools/compare.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@playwright/test": "1.64.1"
  }
}
