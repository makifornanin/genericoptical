{
  "name": "optical-customer-website",
  "version": "1.0.0",
  "private": true,
  "description": "Customer-facing website for an optical shop or eye clinic. Next.js on Vercel; business data from the dashboard's public API.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev -p 3200",
    "build": "next build",
    "start": "next start -p 3200",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "fixtures": "node tests/fixtures/api-server.mjs",
    "test:build": "node tests/fixtures/build-with-fixtures.mjs",
    "test:e2e": "playwright test",
    "test": "npm run test:build && npm run test:e2e",
    "screenshots": "node tests/tools/screenshots.mjs",
    "compare": "node tests/tools/compare.mjs"
  },
  "dependencies": {
    "next": "16.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.1",
    "typescript": "^5.9.3"
  }
}
